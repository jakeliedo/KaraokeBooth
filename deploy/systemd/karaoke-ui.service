# ~/.config/systemd/user/karaoke-ui.service
# Được session.sh khởi động sau khi X và openbox đã sẵn sàng.

[Unit]
Description=KaraokeBooth touchscreen UI
After=graphical-session.target karaoke-core.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
Environment=KARAOKE_API=http://127.0.0.1:8080
ExecStart=/opt/karaoke/venv/bin/python -m karaoke_ui
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=graphical-session.target
