# ~/.config/systemd/user/karaoke-ui.service
# Được session.sh khởi động sau khi X và xrandr đã thiết lập dual-monitor.
# Chạy Chromium kiosk trên màn cảm ứng (TOUCH_OUT, pos 0×0 = screen 0).

[Unit]
Description=KaraokeBooth kiosk UI (Chromium on touch screen)
After=graphical-session.target karaoke-core.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0

# Chromium kiosk: cửa sổ fullscreen ở góc 0,0 (màn ELO là TOUCH_OUT, primary)
ExecStart=chromium \
    --kiosk \
    --window-position=0,0 \
    --window-size=1920,1080 \
    --no-sandbox \
    --disable-translate \
    --noerrdialogs \
    --disable-session-crashed-bubble \
    --disable-infobars \
    --disable-features=TranslateUI \
    --autoplay-policy=no-user-gesture-required \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --app=http://127.0.0.1/kiosk

Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=graphical-session.target
