[Plymouth Theme]
Name=Karaoke
Description=Man loading karaoke - nen den, spinner, khong hien text boot Debian
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/karaoke
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
HorizontalAlignment=.5
VerticalAlignment=.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x1e1e1e
ProgressBarForegroundColor=0x00f5ff

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
