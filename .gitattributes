# Máy đích là Linux. File nào chạy trên đó thì bắt buộc LF — script .sh có CRLF
# sẽ lỗi "bad interpreter: /usr/bin/env bash^M" và rất khó nhìn ra.
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.desktop       text eol=lf
*.toml          text eol=lf
*.sql           text eol=lf
*.qml           text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf

*.png           binary
*.jpg           binary
*.sf2           binary
